# Copy this file to .env (or export these as real environment variables) and
# fill in real values. Never commit .env or real secrets to git.
#
# Every variable here has a fallback default in application.yml so the app
# runs out of the box for local development — but the ones marked
# "REQUIRED IN PRODUCTION" either have no default (the feature silently
# fails until set) or a default that must not be reused outside a laptop.

# ── Database ─────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/sanitation_hub
DB_USERNAME=postgres
DB_PASSWORD=                       # REQUIRED IN PRODUCTION — default is a throwaway dev password

# ── Redis (cache) ────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=                        # REQUIRED IN PRODUCTION — default is a placeholder string, not a real secret
ADMIN_EMAIL=admin@sanitation-hub.local
ADMIN_PASSWORD=                    # REQUIRED IN PRODUCTION — change from the seeded default after first login
ADMIN_NAME=System Administrator

# ── reCAPTCHA (get real keys from https://www.google.com/recaptcha/admin) ─
CAPTCHA_ENABLED=true
CAPTCHA_PROVIDER=recaptcha
CAPTCHA_SITE_KEY=                  # REQUIRED — no default, registration forms fail closed until set
CAPTCHA_SECRET_KEY=                # REQUIRED — no default, registration forms fail closed until set

# ── UNZA Online Application Portal (OAP) integration ────────────────────
OAP_LOGIN_URL=https://devoap.unza.zm/api/v1/students/login
OAP_API_TOKEN=                     # REQUIRED — no default, get from the UNZA OAP team

# ── LDAP (institutional single sign-on) ─────────────────────────────────
LDAP_ENABLED=false
LDAP_URL=ldap://ldap.unza.zm:389
LDAP_BASE_DN=dc=unza,dc=zm
LDAP_USER_DN_PATTERN=uid={0},ou=People
LDAP_USER_SEARCH_BASE=ou=People
LDAP_USER_SEARCH_FILTER=(uid={0})
LDAP_EMAIL_ATTR=mail
LDAP_NAME_ATTR=cn
LDAP_MANAGER_DN=
LDAP_MANAGER_PASSWORD=

# ── Mail ─────────────────────────────────────────────────────────────────
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@sanitation-hub.unza.ac.zm

# ── App / storage / backups ─────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
STORAGE_ROOT=storage
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30           # backups older than this are pruned by the scheduled job
